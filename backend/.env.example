# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-haiku-4-5-20251001   # default (lowest latency); claude-sonnet-4-6 for richer replies

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+14155551234        # a Twilio voice-capable number you own

# ---- Google Cloud (Speech-to-Text + Text-to-Speech enabled) ----
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---- Networking ----
# Public HTTPS URL of THIS backend, no trailing slash.
# Local dev: run `ngrok http 8000` and paste the https URL here.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---- Optional tuning ----
# ENGLISH_STT_CODE=en-IN
# ENGLISH_TTS_VOICE=en-IN-Chirp3-HD-Aoede   # run list_voices.py en-IN to see options
# MALAYALAM_STT_CODE=ml-IN
# MALAYALAM_TTS_VOICE=ml-IN-Chirp3-HD-Aoede # run list_voices.py ml-IN to see options
# ENABLE_CODE_SWITCHING=true
# CORS_ORIGINS=http://localhost:5173
