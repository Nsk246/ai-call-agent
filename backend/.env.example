# ---- Gemini (call brain: Live speech-to-speech + transcripts + summaries) ----
# Get a key at aistudio.google.com. Live native-audio models need a billed project.
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides (defaults shown)
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview   # fallback: gemini-live-2.5-flash-native-audio
# GEMINI_VOICE=Aoede                                # Kore, Leda, Zephyr, Puck, Charon, Fenrir, Orus
# TRANSCRIPT_MODEL=gemini-2.5-flash                 # callee transcripts + outcome summaries

# ---- Twilio (telephony) ----
# Console dashboard -> Account Info. Trial accounts: verify the destination
# number first; enable geo permissions for India if calling +91.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+14155551234

# ---- Google Cloud (ONLY for voice audition previews in the UI) ----
# Service account JSON with Text-to-Speech enabled. Optional: previews return
# 503 without it, everything else works.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---- Networking ----
# Public HTTPS URL of this backend, no trailing slash. Twilio must reach it.
# Codespaces: https://$CODESPACE_NAME-8000.app.github.dev (set port 8000 Public)
# Local: an ngrok https URL
PUBLIC_BASE_URL=https://your-public-url

# CORS_ORIGINS=*
